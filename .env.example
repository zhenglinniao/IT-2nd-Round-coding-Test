# 复制为项目根目录 .env 后填写。已有 .env 时请勿覆盖。
# 仅供服务端读取，禁止在变量名前添加 VITE_，禁止提交真实凭据。

# Australia Post / StarTrack：Basic Auth 凭据；为空时对应物流显示未配置。
AUSPOST_API_KEY=
AUSPOST_API_SECRET=
# 账号按字符串填写，保留所有前导零。
AUSPOST_STARTRACK_ACCOUNT=
AUSPOST_POST_ACCOUNT=

# 默认使用官方测试环境，其轨迹不代表订单实际运输记录。
# 生产地址为 https://digitalapi.auspost.com.au/shipping/v1，需另有生产权限。
AUSPOST_BASE_URL=https://digitalapi.auspost.com.au/test/shipping/v1

# TNT 澳大利亚官方公开追踪：无需账号密码，仅支持 9 位数字国内运单号。
# true 启用外部查询；false 关闭。与 Australia Post 配置相互独立。
TNT_TRACKING_ENABLED=true

# 题目公式运费估算，非承运商报价。TNT 报价未实现，费用仍为 A$0.00。
# true 启用；false 关闭。需要复现 README 中含运费的演示总额时设为 true。
SHIPPING_ESTIMATE_ENABLED=false

# 留空使用项目 data 目录。自定义目录需含 orders.json 和 products.json。
# 建议填绝对路径，例如 C:/path/to/order-data（路径中有空格时可加双引号）。
DATA_DIR=
